### Performance Optimization - Faster Startup
# JMX-Overhead vermeiden
spring.jmx.enabled=false
# Bis zu 200 Worker-Threads
server.tomcat.threads.max=200
# 10 permanente Threads
server.tomcat.threads.min-spare=10
# Virtual Threads (Java 21+)
spring.threads.virtual.enabled=true
# Show all auto-configuration classes (for debugging)
debug=false
application.timezone=Europe/Berlin

# App Properties
spring.application.name=Supply Chain Management
app.name=${spring.application.name}
app.version=1.0.0
app.description=${app.name} demo project to show SCM processes

# Database Properties
spring.datasource.url=jdbc:mariadb://h3:3306/XXXXXXXXXXXXXX?serverVersion=11.8.6-MariaDB&charset=utf8mb4&useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=XXXXXXXXXXXXXXX
spring.datasource.password=XXXXXXXXXXXXXXX

# JPA Properties
spring.jpa.database-platform=org.hibernate.dialect.MariaDBDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Server / Logging
server.port=8080
logging.file.name=logs/app-${server.port}.log

# API versioning: clients may omit the version, ApiVersionDefaultFilter rewrites
# /api/... to /api/${spring.mvc.apiversion.default}/... before the request is routed.
spring.mvc.apiversion.default=1.0

# Seed data loaded on startup, path relative to the classpath.
app.mysqldatafile=/data-mysql.sql

# JWT Properties
# The secret is the HMAC key for HS256 - JwtTokenProvider hands it to Keys.hmacShaKeyFor(),
# which rejects anything shorter than 256 bits. Replace this placeholder with your own value;
# keep it out of version control (the live application*.properties files are git-ignored).
app.jwtSecret=CHANGE_ME_this_placeholder_only_exists_so_a_fresh_checkout_starts_replace_it_with_a_real_secret
# 1800000 ms = 30 minutes
app.jwtExpirationMs=1800000

# Cookie carrying the JWT. secure=false for local http development; set it to true
# wherever the app is served over https, otherwise the browser drops the cookie.
# Which other origins a browser may call the API from, comma separated. Empty (the default in code)
# means none: right when the frontend is served from the same origin as the API, or through a dev
# proxy. Set it per deployment - CORS_ALLOWED_ORIGINS in the environment wins over the value here.
# Never "*": the session is a cookie, and a wildcard cannot go with credentials.
app.cors.allowedOrigins=${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:3000}
app.cookie.name=scmcookie
app.cookie.secure=false

# OpenAPI description of the REST API (/v3/api-docs) and Swagger UI (/swagger-ui.html).
# Off unless switched on (openapi-defaults.properties): it lists every endpoint and the roles that may
# call it, and is served without a login. Switch both on for development - leave them off where the
# application is reachable by people who are not developers. OPENAPI_ENABLED in the environment wins.
springdoc.api-docs.enabled=${OPENAPI_ENABLED:false}
springdoc.swagger-ui.enabled=${OPENAPI_ENABLED:false}
